---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, experience, education, skills } from '../data/site';
import { notes } from '../data/notes';
import { withBase } from '../paths';
import '../styles/notes-contact.css';
const indicators = [
 {value:projects.length,label:'项目与实践',description:'个人产品、企业开发、研究与教学',href:'/projects'},
 {value:experience.length,label:'经历记录',description:'工作、实习与团队训练',href:'/resume#experience'},
 {value:education.length,label:'学科背景',description:'计算机科学与技术 / 岩土工程',href:'/resume#education'},
 {value:notes.length,label:'站内笔记',description:'每一篇都有可以阅读的正文',href:'/writing'},
];
const groups=[
 {name:'产品交付',text:'从菜单到记录，从页面到接口。',tags:['微信小程序','Java','Spring Boot','MySQL'],href:'/projects/mage-xiaoguan'},
 {name:'业务协作',text:'理解采购、招标和多端交互。',tags:['Vue','JavaScript','ElementUI','接口联调'],href:'/projects/procurement'},
 {name:'工程研究',text:'连接工程图像、数据与开发。',tags:['Python','图像识别','数据标注'],href:'/projects/tunnel-ai'},
 {name:'技术表达',text:'把知识拆解成可理解的步骤。',tags:['C','Python','Scratch','课程规划'],href:'/projects/coding-class'},
];
---
<BaseLayout title="能力索引" description="从真实项目与经历出发，了解马志昊的产品交付、业务协作、工程研究与技术表达能力。">
<section class="portfolio-wrap editorial-head"><p class="eyebrow">AT A GLANCE / EVIDENCE FIRST</p><h1>技能之后，<br />是解决过的问题。</h1><p>这里的数字来自本站实际收录的内容；每一种能力，都能找到对应的项目或经历。</p></section>
<section class="portfolio-wrap evidence-stats"><div class="evidence-counts">{indicators.map(item=><a href={withBase(item.href)}><strong>{item.value}</strong><h2>{item.label} ↗</h2><p>{item.description}</p></a>)}</div><div class="evidence-groups">{groups.map(group=><a href={withBase(group.href)}><h2>{group.name}<span aria-hidden="true">↗</span></h2><p>{group.text}</p><div class="p-tags">{group.tags.map(tag=><span>{tag}</span>)}</div></a>)}</div><p class="evidence-caption">技能清单整理自公开简历，共 {skills.length} 项。这里不使用主观的“熟练度百分比”，可以进入对应案例了解实际应用。</p></section>
</BaseLayout>
<style>
.evidence-stats{padding-bottom:80px;}.evidence-counts{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);}.evidence-counts a{padding:25px;border-right:1px solid var(--line);text-decoration:none;}.evidence-counts a:last-child{border:0;}.evidence-counts strong{font-size:48px;font-weight:600;}.evidence-counts h2{font-size:16px;}.evidence-counts p,.evidence-groups p{font-size:13px;color:var(--muted);}.evidence-groups{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:38px;}.evidence-groups>a{padding:28px;background:var(--panel);border:1px solid var(--line);border-radius:12px;text-decoration:none;}.evidence-groups h2{font-size:22px;display:flex;justify-content:space-between;margin-top:0;}.evidence-caption{font-size:12px;color:var(--faint);margin-top:30px;}@media(max-width:650px){.evidence-counts{grid-template-columns:1fr 1fr;}.evidence-counts a{padding:20px 12px;}.evidence-counts a:nth-child(2){border:0;}.evidence-groups{grid-template-columns:1fr;}}
</style>
