---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, experience, education, skills } from '../data/site';
import { notes } from '../data/notes';
import { withBase } from '../paths';
import '../styles/notes-contact.css';
const indicators = [
 {value:projects.length,label:'项目与实践',description:'个人产品、企业开发、研究与教学',href:'/projects'},
 {value:experience.length,label:'经历记录',description:'工作、实习与团队训练',href:'/resume#experience'},
 {value:education.length,label:'学科背景',description:'计算机科学与技术 / 岩土工程',href:'/resume#education'},
 {value:notes.length,label:'站内笔记',description:'产品设计、开发与研究方法',href:'/writing'},
];
const groups=[
 {name:'小程序与全栈开发',text:'馬哥小馆儿 · 点餐、家庭管理与后端服务',tags:['微信小程序','Java','Spring Boot','MySQL'],href:'/projects/mage-xiaoguan'},
 {name:'业务前端',text:'采购平台与招标小程序 · 页面开发、接口联调',tags:['Vue','JavaScript','ElementUI','接口联调'],href:'/projects/procurement'},
 {name:'工程图像识别',text:'隧道病害识别 · Python 开发与图像标注',tags:['Python','图像识别','数据标注'],href:'/projects/tunnel-ai'},
 {name:'编程教学',text:'莱凯创客 · 课程规划、教学与项目指导',tags:['C','Python','Scratch','课程规划'],href:'/projects/coding-class'},
];
---
<BaseLayout title="能力索引" description="从真实项目与经历出发，了解马志昊的产品交付、业务协作、工程研究与技术表达能力。">
<section class="portfolio-wrap editorial-head"><p class="eyebrow">SKILLS / PROJECTS</p><h1>能力索引</h1><p>选择一个方向，查看对应项目与职责。</p></section>
<section class="portfolio-wrap evidence-stats"><div class="evidence-counts">{indicators.map(item=><a href={withBase(item.href)}><strong>{item.value}</strong><h2>{item.label} <span aria-hidden="true">↗</span></h2><p>{item.description}</p></a>)}</div><div class="evidence-groups">{groups.map(group=><a href={withBase(group.href)}><h2>{group.name}<span aria-hidden="true">↗</span></h2><p>{group.text}</p><div class="p-tags">{group.tags.map(tag=><span>{tag}</span>)}</div></a>)}</div><p class="evidence-caption">数量以本站内容为准。<a href={withBase('/resume#skills')}>查看 {skills.length} 项技能 →</a></p></section>
</BaseLayout>
<style>
.evidence-counts a:hover,.evidence-counts a:focus-visible,.evidence-groups>a:hover,.evidence-groups>a:focus-visible{background:var(--panel-soft);}.evidence-counts a:hover h2,.evidence-counts a:focus-visible h2,.evidence-groups>a:hover h2,.evidence-groups>a:focus-visible h2{color:var(--blue);}.evidence-groups h2 span{flex-shrink:0;margin-left:12px;}
.evidence-stats{padding-bottom:80px;}.evidence-counts{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);}.evidence-counts a{padding:25px;border-right:1px solid var(--line);text-decoration:none;}.evidence-counts a:last-child{border:0;}.evidence-counts strong{font-size:48px;font-weight:600;}.evidence-counts h2{font-size:16px;}.evidence-counts p,.evidence-groups p{font-size:13px;color:var(--muted);}.evidence-groups{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:38px;}.evidence-groups>a{padding:28px;background:var(--panel);border:1px solid var(--line);border-radius:12px;text-decoration:none;}.evidence-groups h2{font-size:22px;display:flex;justify-content:space-between;margin-top:0;}.evidence-caption{font-size:12px;color:var(--faint);margin-top:30px;}@media(max-width:650px){.evidence-counts{grid-template-columns:1fr 1fr;}.evidence-counts a{padding:20px 12px;}.evidence-counts a:nth-child(2){border:0;}.evidence-groups{grid-template-columns:1fr;}}
</style>
