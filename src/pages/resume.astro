---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionNav from '../components/SectionNav.astro';
import { education, experience, projects, site } from '../data/site';
import { withBase } from '../paths';
import '../styles/experience.css';

const resumeSections = [
  { id: 'experience', label: '工作与实践' },
  { id: 'education', label: '教育背景' },
  { id: 'skills', label: '技术能力' },
  { id: 'projects', label: '项目索引' },
  { id: 'awards', label: '荣誉与责任' },
];
const projectSlugs = ['mage-xiaoguan', 'procurement', 'tunnel-ai', 'takeout-training', 'coding-class'];
const experienceProjects: Record<string, { slug: string; label: string }> = {
  '辽宁省交通科学研究院': { slug: 'tunnel-ai', label: '隧道病害图像识别' },
  '莱凯创客机器人编程俱乐部': { slug: 'coding-class', label: '编程教学实践' },
  '禹王投资控股有限公司': { slug: 'procurement', label: '采购平台与招标小程序' },
  '东软教育集团（培训）': { slug: 'takeout-training', label: '外卖平台训练项目' },
};
const experienceIds: Record<string, string> = {
  '山东省禹城市住房与城乡建设局': 'housing-internship',
  '辽宁省交通科学研究院': 'tunnel-ai',
  '莱凯创客机器人编程俱乐部': 'coding-class',
  '禹王投资控股有限公司': 'procurement',
  '东软教育集团（培训）': 'takeout-training',
};
const capabilities = [
  { title: '前端与小程序', description: '业务页面开发、接口联调与数据迁移。', tools: ['JavaScript', 'Vue', 'ElementUI', '微信小程序'], slug: 'procurement', evidence: '查看企业采购与招标项目' },
  { title: '后端与部署', description: '点餐接口、微信登录、云部署与测试。', tools: ['Java', 'Spring Boot', 'MySQL', 'JUnit', '云托管'], slug: 'mage-xiaoguan', evidence: '查看馬哥小馆儿' },
  { title: '图像识别', description: '识别代码开发、人工标注与资料整理。', tools: ['Python', '图像识别', '数据标注'], slug: 'tunnel-ai', evidence: '查看隧道病害识别实践' },
  { title: '编程教学', description: '备课、课堂讲授、学习反馈与项目辅导。', tools: ['C', 'Python', 'Scratch', 'XRmaker'], slug: 'coding-class', evidence: '查看课程与教学实践' },
];
---

<BaseLayout title="经历与简历" description={site.name + '的教育、工作与项目经历：计算机科学与岩土工程交叉背景，企业前端、微信小程序、图像识别与教学实践。'}>
  <div class="portfolio-wrap cv-page">
    <header class="cv-hero">
      <div>
        <p class="journey-eyebrow">RESUME / THE JOURNEY</p>
        <h1>{site.name}<span>全栈开发 · 图像识别 · 岩土工程</span></h1>
        <p class="cv-intro">计算机科学本科，岩土工程硕士在读。企业前端、个人产品、研究与教学经历。</p>
        <p class="cv-contact"><span>{site.role}</span><span>{site.location}</span><a href={'mailto:' + site.email}>{site.email}</a></p>
      </div>
      <div class="cv-actions">
        <button class="cv-print-button" type="button" data-print-resume>
          <Icon name="print" />
          打印 / 保存为 PDF
        </button>
        <a href={withBase('/contact')}>联系我 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="cv-overview anchor-section" id="overview" aria-labelledby="cv-overview-title">
      <div class="cv-overview-heading"><span class="journey-eyebrow">AT A GLANCE</span><h2 id="cv-overview-title">简历速览</h2></div>
      <a href="#education"><span class="cv-overview-label">01 / 教育</span><strong>计算机科学 × 岩土工程</strong><span>齐鲁理工学院 → 沈阳建筑大学</span><span class="cv-overview-arrow" aria-hidden="true">↗</span></a>
      <a href={withBase('/projects/mage-xiaoguan')}><span class="cv-overview-label">02 / 代表作品</span><strong>馬哥小馆儿</strong><span>微信小程序 · Spring Boot · MySQL</span><span class="cv-overview-arrow" aria-hidden="true">↗</span></a>
      <a href="#experience"><span class="cv-overview-label">03 / 工作与实践</span><strong>开发 · 研究 · 教学</strong><span>查看职责、时间与相关项目</span><span class="cv-overview-arrow" aria-hidden="true">↗</span></a>
    </section>

    <div class="cv-layout">
      <aside class="cv-sidebar">
        <span class="journey-eyebrow">IN THIS RESUME</span>
        <SectionNav label="简历目录" items={resumeSections} />
      </aside>
      <div class="cv-content">
        <section class="cv-section anchor-section" id="experience" aria-labelledby="experience-title">
          <div class="journey-section-heading"><span>01</span><div><p class="journey-eyebrow">EXPERIENCE</p><h2 id="experience-title">工作与实践</h2></div></div>
          <div class="journey-timeline">
            {experience.map((item) => (
              <article class="journey-entry" id={`experience-${experienceIds[item.organization]}`}>
                <p class="journey-period">{item.period}</p>
                <h3>{item.title}</h3>
                <p class="journey-organization">{item.organization}</p>
                <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                {experienceProjects[item.organization] && <a class="journey-evidence-link" href={withBase('/projects/' + experienceProjects[item.organization].slug)}>相关实践：{experienceProjects[item.organization].label}<span aria-hidden="true">↗</span></a>}
              </article>
            ))}
          </div>
        </section>

        <section class="cv-section anchor-section" id="education" aria-labelledby="education-title">
          <div class="journey-section-heading"><span>02</span><div><p class="journey-eyebrow">EDUCATION</p><h2 id="education-title">教育背景</h2></div></div>
          <div class="cv-education-list">
            {education.map((item) => <article class="cv-education-card"><p class="journey-period">{item.period}</p><h3>{item.organization}</h3><p class="cv-degree">{item.title}</p><p>{item.summary}</p></article>)}
          </div>
        </section>

        <section class="cv-section anchor-section" id="skills" aria-labelledby="skills-title">
          <div class="journey-section-heading"><span>03</span><div><p class="journey-eyebrow">TECHNICAL SKILLS</p><h2 id="skills-title">技术能力</h2></div></div>
          <div class="cv-capabilities">
            {capabilities.map((item) => <a class="cv-capability" href={withBase('/projects/' + item.slug)}><h3>{item.title}</h3><p>{item.description}</p><div class="journey-pills">{item.tools.map((tool) => <span>{tool}</span>)}</div><span class="journey-evidence-link">{item.evidence}<span aria-hidden="true">↗</span></span></a>)}
          </div>
        </section>

        <section class="cv-section anchor-section" id="projects" aria-labelledby="projects-title">
          <div class="journey-section-heading"><span>04</span><div><p class="journey-eyebrow">SELECTED PRACTICE</p><h2 id="projects-title">项目索引</h2></div></div>
          <div class="cv-project-index">
            {projects.map((project, index) => <a href={withBase('/projects/' + projectSlugs[index])} class="cv-project-row"><span class="journey-period">{project.year}</span><span><strong>{project.title}</strong><span>{project.subtitle}</span></span><span class="cv-project-arrow" aria-hidden="true">↗</span></a>)}
          </div>
        </section>

        <section class="cv-section anchor-section" id="awards" aria-labelledby="awards-title">
          <div class="journey-section-heading"><span>05</span><div><p class="journey-eyebrow">RECOGNITION & RESPONSIBILITY</p><h2 id="awards-title">荣誉与责任</h2></div></div>
          <div class="cv-recognition">
            <article><span class="journey-eyebrow">硕士阶段 / 沈阳建筑大学</span><h3>校级奖学金二等奖</h3></article>
            <article><span class="journey-eyebrow">本科阶段 / 齐鲁理工学院</span><h3>国家励志奖学金</h3><p>专业成绩前 10%，GPA 3.66。</p></article>
            <article><span class="journey-eyebrow">省级竞赛 / 山东省</span><h3>电子与信息大赛三等奖</h3></article>
            <article><span class="journey-eyebrow">学生工作</span><h3>班级与研究生会任职</h3><p>本科副班长；硕士班级团支书、研究生会学术部成员。</p></article>
          </div>
        </section>
      </div>
    </div>
  </div>
  <script>
    document.querySelector<HTMLButtonElement>('[data-print-resume]')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
