---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { education, experience, projects, skills, site } from '../data/site';

const resumeSections = [
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'projects', label: 'Projects' },
  { id: 'awards', label: 'Awards' },
];
---

<BaseLayout title="Resume" description={`${site.name} resume`}>
  <section class="page-section container centered">
    <h1 class="page-title">Resume</h1>
    <p class="lead">
      计算机科学与岩土工程交叉背景，具备企业前端开发、微信小程序、Java 后端协作、图像识别与工程文档沉淀经验。
      近期个人项目“馬哥小馆儿”已覆盖小程序端、后端接口、云部署和自动化测试。
    </p>
    <SectionNav label="Resume sections" items={resumeSections} />
  </section>

  <section class="page-section container anchor-section" id="experience">
    <h2 class="section-title page-title centered">Experience</h2>
    <div class="resume-list">
      {experience.map((item) => (
        <article class="resume-card">
          <p class="resume-meta">{item.period} · {item.organization}</p>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
          <ul>
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section container anchor-section" id="education">
    <h2 class="section-title page-title centered">Education</h2>
    <div class="resume-list">
      {education.map((item) => (
        <article class="resume-card">
          <p class="resume-meta">{item.period} · {item.organization}</p>
          <h2>{item.title}</h2>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section container centered anchor-section" id="skills">
    <h2 class="section-title page-title">Skills</h2>
    <div class="badge-row">
      {skills.map((skill) => <span class="badge">{skill}</span>)}
    </div>
  </section>

  <section class="page-section container anchor-section" id="projects">
    <h2 class="section-title page-title centered">Projects</h2>
    <div class="resume-list">
      {projects.slice(0, 3).map((project) => (
        <article class="resume-card">
          <p class="resume-meta">{project.year} · {project.subtitle}</p>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <div class="tag-row">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section container anchor-section" id="awards">
    <h2 class="section-title page-title centered">Awards</h2>
    <div class="resume-list">
      <article class="resume-card">
        <p class="resume-meta">本科阶段 · 齐鲁理工学院</p>
        <h2>国家励志奖学金</h2>
        <p>专业成绩前 10%，GPA 3.66。</p>
      </article>
      <article class="resume-card">
        <p class="resume-meta">省级竞赛 · 山东省</p>
        <h2>电子与信息大赛三等奖</h2>
        <p>在本科阶段参与电子与信息方向竞赛并获得省级三等奖。</p>
      </article>
    </div>
  </section>
</BaseLayout>
