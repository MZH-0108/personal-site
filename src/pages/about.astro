---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { site } from '../data/site';
import { withBase } from '../paths';
import '../styles/experience.css';

const aboutSections = [
  { id: 'history', label: '经历概况' },
  { id: 'likes', label: '关注方向' },
  { id: 'skills', label: '技术能力' },
  { id: 'fun-facts', label: '工作方式' },
  { id: 'dreams', label: '接下来' },
];
const approach = [
  { number: '01', title: '先定需求，再拆任务', text: '明确使用者、功能与权限范围。', detail: '馬哥小馆儿围绕家庭菜谱、点餐记录和管理员权限组织功能。', link: '/projects/mage-xiaoguan', label: '查看点餐项目' },
  { number: '02', title: '用文档和教学沟通', text: '按使用者基础组织说明。', detail: '教授 C、Python、Scratch 与 XRmaker，根据学生基础安排课程和项目练习。', link: '/projects/coding-class', label: '查看教学实践' },
  { number: '03', title: '开发包含测试和部署', text: '页面之外，关注接口与维护。', detail: '馬哥小馆儿使用云托管部署，并通过 JUnit 进行自动化测试。', link: '/projects/mage-xiaoguan#implementation-3', label: '查看后端与测试' },
];
---

<BaseLayout title="关于我" description={'认识' + site.name + '：从计算机科学到岩土工程，从软件开发到编程教学，用真实经历连接技术与使用场景。'}>
  <div class="portfolio-wrap profile-page">
    <header class="profile-hero">
      <div class="profile-hero-copy">
        <p class="journey-eyebrow">ABOUT / ZHIHAO MA</p>
        <h1>计算机科学本科，<br />岩土工程硕士在读。</h1>
        <p>我是{site.name}，现就读于沈阳建筑大学。做过企业前端、图像识别与编程教学，正在开发家庭点餐小程序。</p>
        <a class="journey-evidence-link" href={withBase('/resume')}>查看完整简历 <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="profile-coordinate" aria-label="我的关注方向">
        <span class="journey-eyebrow">QUICK LINKS</span>
        <p class="profile-coordinate-title">三个方向</p>
        <a href={withBase('/projects/mage-xiaoguan')}><span>01</span><strong>软件开发 ↗</strong><p>前端、小程序与后端</p></a>
        <a href={withBase('/projects/tunnel-ai')}><span>02</span><strong>工程与 AI ↗</strong><p>图像识别与数据标注</p></a>
        <a href={withBase('/projects/coding-class')}><span>03</span><strong>编程教学 ↗</strong><p>课程规划与项目辅导</p></a>
        <span class="profile-coordinate-location">{site.location}</span>
      </aside>
    </header>
    <div class="profile-nav"><SectionNav label="关于我目录" items={aboutSections} /></div>

    <section class="profile-section anchor-section" id="history" aria-labelledby="history-title">
      <div class="profile-section-label"><span class="journey-eyebrow">01 / THE PATH</span><h2 id="history-title">经历概况</h2></div>
      <div class="profile-section-content">
        <p class="profile-large-copy">软件开发 → 编程教学 → <em>工程与 AI</em></p>
        <div class="profile-path">
          <a href={withBase('/resume#education')}><strong>2018 — 2022</strong><span>计算机科学本科</span><small>齐鲁理工学院 ↗</small></a>
          <a href={withBase('/resume#experience-procurement')}><strong>2022 — 2024</strong><span>企业前端开发</span><small>采购平台与招标小程序 ↗</small></a>
          <a href={withBase('/resume#experience-coding-class')}><strong>2024</strong><span>机器人与编程教学</span><small>金牌讲师 ↗</small></a>
          <a href={withBase('/resume#experience-tunnel-ai')}><strong>2025</strong><span>隧道病害图像识别</span><small>辽宁省交通科学研究院 ↗</small></a>
          <a href={withBase('/resume#education')}><strong>2025 — 至今</strong><span>岩土工程硕士</span><small>沈阳建筑大学 ↗</small></a>
        </div>
      </div>
    </section>

    <section class="profile-section anchor-section" id="likes" aria-labelledby="likes-title">
      <div class="profile-section-label"><span class="journey-eyebrow">02 / INTERESTS</span><h2 id="likes-title">关注方向</h2></div>
      <div class="profile-section-content profile-interest-grid">
        <a class="profile-interest" href={withBase('/projects/mage-xiaoguan')}><span class="profile-interest-index">01 / 个人产品</span><h3>家庭点餐小程序</h3><p>菜谱记录、点餐准备与家庭成员管理。</p><span class="journey-evidence-link">查看馬哥小馆儿 <span aria-hidden="true">↗</span></span></a>
        <a class="profile-interest" href={withBase('/projects/tunnel-ai')}><span class="profile-interest-index">02 / 工程 AI</span><h3>图像识别与工程检测</h3><p>从隧道病害图像标注，继续学习计算机视觉。</p><span class="journey-evidence-link">查看研究实践 <span aria-hidden="true">↗</span></span></a>
      </div>
    </section>

    <section class="profile-section anchor-section" id="skills" aria-labelledby="about-skills-title">
      <div class="profile-section-label"><span class="journey-eyebrow">03 / SKILLS</span><h2 id="about-skills-title">技术能力</h2></div>
      <div class="profile-section-content">
        <div class="profile-skill-list">
          <a href={withBase('/projects/mage-xiaoguan')}><span>开发</span><div><h3>前端、小程序与后端接口</h3><p>Vue · JavaScript · 微信小程序 · Java · Spring Boot</p></div><span aria-hidden="true">↗</span></a>
          <a href={withBase('/projects/tunnel-ai')}><span>研究</span><div><h3>图像识别代码与人工标注</h3><p>Python · 图像识别 · 数据标注</p></div><span aria-hidden="true">↗</span></a>
          <a href={withBase('/projects/coding-class')}><span>教学</span><div><h3>课程规划、讲授与项目辅导</h3><p>C · Python · Scratch · XRmaker</p></div><span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="profile-section anchor-section" id="fun-facts" aria-labelledby="working-title">
      <div class="profile-section-label"><span class="journey-eyebrow">04 / WORKING TOGETHER</span><h2 id="working-title">工作方式</h2><p>展开查看项目中的例子。</p></div>
      <div class="profile-section-content profile-approach">
        {approach.map((item) => <details class="profile-detail"><summary><span class="profile-detail-number">{item.number}</span><span><strong>{item.title}</strong><span>{item.text}</span></span><span class="profile-detail-toggle" aria-hidden="true">+</span></summary><div class="profile-detail-content"><p>{item.detail}</p><a class="journey-evidence-link" href={withBase(item.link)}>{item.label} <span aria-hidden="true">↗</span></a></div></details>)}
      </div>
    </section>

    <section class="profile-section anchor-section" id="dreams" aria-labelledby="next-title">
      <div class="profile-section-label"><span class="journey-eyebrow">05 / WHAT'S NEXT</span><h2 id="next-title">接下来</h2></div>
      <div class="profile-section-content"><p class="profile-large-copy">继续学习工程 AI，完善个人产品。</p><p>欢迎交流软件开发、图像识别与工程应用。</p><a class="journey-evidence-link" href={withBase('/contact')}>联系我 <span aria-hidden="true">↗</span></a></div>
    </section>
  </div>
</BaseLayout>
