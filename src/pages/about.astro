---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionNav from '../components/SectionNav.astro';
import { skills, site } from '../data/site';
import { withBase } from '../paths';

const aboutSections = [
  { id: 'history', label: 'Some History' },
  { id: 'likes', label: 'I Like' },
  { id: 'skills', label: 'Skills' },
  { id: 'fun-facts', label: 'Fun Facts' },
  { id: 'dreams', label: 'I Dream Of' },
];
---

<BaseLayout title="About" description={`About ${site.name}`}>
  <section class="page-section container">
    <h1 class="page-title">About</h1>
    <div class="prose">
      <p>
        我是马志昊，本科是计算机科学与技术，现在在沈阳建筑大学读岩土工程硕士。我的兴趣点在工程问题和软件能力的交叉处：
        用全栈开发把工具做出来，用 AI 和图像识别把工程场景里的数据用起来。
      </p>
      <p>
        过去我做过企业采购平台、招标小程序、外卖平台训练项目，也参与过隧道病害图像识别相关工作。最近的个人项目是
        <a href={withBase('/projects')}>馬哥小馆儿微信小程序</a>，从需求边界、微信登录、后台接口到云部署和测试都由我推进。
      </p>
      <p>
        我喜欢把复杂任务拆小、把经验写下来，再把“能用”的东西一点点做成“好用”。这个网站会作为我的项目、简历、
        学习笔记和联系方式的公开主页。
      </p>
    </div>

    <SectionNav label="About sections" items={aboutSections} />
  </section>

  <div class="container about-detail-list">
    <section class="card about-detail anchor-section" id="history">
      <p class="about-detail-kicker">Some History</p>
      <h2>从计算机到岩土工程</h2>
      <p>本科阶段学习计算机科学与技术，积累了前端、Java、数据库和团队项目经验；研究生阶段进入岩土工程方向，开始关注软件、AI 与工程检测的交叉应用。</p>
    </section>

    <section class="card about-detail anchor-section" id="likes">
      <p class="about-detail-kicker">I Like</p>
      <h2>把复杂问题做成可用工具</h2>
      <p>喜欢 Web 前端、微信小程序、Java 后端接口、工程数据处理，以及 AI / 图像识别方向的学习和实践。</p>
    </section>

    <section class="card about-detail anchor-section" id="skills">
      <p class="about-detail-kicker">Skills</p>
      <h2>技术与工具</h2>
        <div class="tag-row">
          {skills.map((skill) => <span class="tag">{skill}</span>)}
        </div>
    </section>

    <section class="card about-detail anchor-section" id="fun-facts">
      <p class="about-detail-kicker">Fun Facts</p>
      <h2>我如何工作</h2>
      <p>先明确目标和边界，再小步实现、持续测试、沉淀文档；遇到复杂问题时，我通常会先画清流程再开始写代码。</p>
    </section>

    <section class="card about-detail anchor-section" id="dreams">
      <p class="about-detail-kicker">I Dream Of</p>
      <h2>连接工程场景与软件能力</h2>
      <p>希望持续做出真正进入使用流程的软件，让工程问题中的数据、知识和协作变得更清晰、更高效。</p>
    </section>
  </div>
</BaseLayout>
