---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, projects } from '../data/site';
import { notes } from '../data/notes';
import { withBase } from '../paths';
import portrait from '../../public/images/avatar-home-ivory.png';
import restaurant from '../../public/images/projects/mage-xiaoguan-feature.png';

const lenses = [
  { id: 'product', icon: 'layer-group', label: '小程序 / 全栈', headline: '小程序、接口、部署与测试', body: '在馬哥小馆儿中实现家庭点餐、微信登录、管理员权限与后端服务。', tags: ['微信小程序', 'Spring Boot', 'MySQL'], proof: '查看馬哥小馆儿', href: '/projects/mage-xiaoguan' },
  { id: 'team', icon: 'code-branch', label: '企业前端', headline: '采购平台与招标小程序', body: '负责业务页面，参与接口联调、数据迁移与项目文档整理。', tags: ['Vue', '接口联调', '技术文档'], proof: '查看企业项目', href: '/projects/procurement' },
  { id: 'research', icon: 'microscope', label: '图像识别', headline: '隧道图像识别与人工标注', body: '在辽宁省交通科学研究院参与识别代码开发、图像标注与技术资料整理。', tags: ['Python', '图像识别', '岩土工程'], proof: '查看研究实践', href: '/projects/tunnel-ai' },
] as const;
---
<BaseLayout title={site.name} description="马志昊的个人网站：计算机与岩土工程交叉背景，展示微信小程序馬哥小馆儿、企业前端开发、图像识别、教学实践与工程思考。">
  <section class="intro-hero portfolio-wrap" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> HELLO, I'M ZHIHAO MA</p>
      <p class="intro-name">你好，我是马志昊。</p>
      <h1 id="intro-title">从小程序，<br />到工程<span> AI。</span></h1>
      <p class="intro-description">计算机科学本科，岩土工程硕士在读。<br class="desktop-break" />做过企业前端、图像识别与编程教学。</p>
      <div class="intro-roles"><span>全栈开发</span><span>AI / 图像识别</span><span>硕士在读</span></div>
      <div class="action-row">
        <a class="p-button p-button-primary" href={withBase('/projects')}>查看作品 <Icon name="arrow-up-right-from-square" /></a>
        <a class="p-button" href={withBase('/resume#overview')}>简历速览 <Icon name="arrow-right" /></a>
      </div>
      <a class="intro-down" href="#selected-work"><span aria-hidden="true">↓</span> 代表作品</a>
    </div>
    <a class="intro-portrait-frame" href={withBase('/about')} aria-label="认识马志昊">
      <div class="portrait-topline"><span>THE PERSON BEHIND THE CODE</span><span aria-hidden="true">↗</span></div>
      <Image src={portrait} alt="马志昊的彩色肖像" width={620} widths={[340,480,620]} sizes="(max-width: 700px) 85vw, 40vw" format="webp" quality={83} loading="eager" fetchpriority="high" class="intro-portrait-image" />
      <div class="portrait-caption"><span><strong>马志昊</strong><small>开发者 · 岩土工程硕士在读</small></span><span class="portrait-seal" aria-hidden="true">{site.initials}<span>BUILD & LEARN</span></span></div>
      <div class="portrait-note"><Icon name="location-dot" /> {site.location}</div>
    </a>
  </section>
  <section class="proof-strip portfolio-wrap" aria-label="经历速览">
    <a href={withBase('/projects')}><strong>{projects.length}<span> 项实践</span></strong><p>产品 · 企业 · 研究 · 教学</p><span class="proof-arrow" aria-hidden="true">↗</span></a>
    <a href={withBase('/resume#education')}><strong>2<span> 个学科</span></strong><p>计算机科学 × 岩土工程</p><span class="proof-arrow" aria-hidden="true">↗</span></a>
    <a href={withBase('/resume#awards')}><strong>3.66</strong><p>本科 GPA · 专业前 10%</p><span class="proof-arrow" aria-hidden="true">↗</span></a>
    <a href={withBase('/projects/procurement#implementation-3')}><strong>30<span> 篇</span></strong><p>过往 CSDN 原创技术文章</p><span class="proof-arrow" aria-hidden="true">↗</span></a>
  </section>
  <section class="portfolio-wrap showcase-section" id="selected-work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">代表作品</h2></div><a class="p-text-link" href={withBase('/projects')}>全部作品 <span aria-hidden="true">↗</span></a></div>
    <article class="spotlight-project">
      <a class="spotlight-visual" href={withBase('/projects/mage-xiaoguan')} aria-label="查看馬哥小馆儿项目案例">
        <Image src={restaurant} alt="馬哥小馆儿项目场景示意：点餐界面与家庭餐桌" width={820} widths={[400,650,820]} sizes="(max-width: 700px) 92vw, 54vw" format="webp" quality={80} loading="lazy" />
        <span class="image-caption">项目场景示意</span><span class="spotlight-open" aria-hidden="true">↗</span>
      </a>
      <div class="spotlight-copy"><p class="eyebrow">FEATURED PROJECT / 2026</p><h3>馬哥小馆儿<span>家庭点餐微信小程序</span></h3><p>菜谱与点餐记录、微信登录、家庭管理。前端到后端的个人项目。</p><div class="p-tags"><span>微信小程序</span><span>Spring Boot</span><span>MySQL</span></div><div class="spotlight-actions"><a class="p-text-link" href={withBase('/projects/mage-xiaoguan')}>项目详情 <span aria-hidden="true">→</span></a><a class="p-text-link" href={withBase('/projects/mage-xiaoguan#demo')}>点餐演示 <span aria-hidden="true">↗</span></a></div></div>
    </article>
    <div class="support-work-grid">
      <a class="support-work" href={withBase('/projects/procurement')}><div class="support-icon"><Icon name="code-branch" /></div><div><p class="eyebrow">ENTERPRISE / 2022 — 2024</p><h3>采购平台与招标小程序</h3><p>业务页面开发、接口联调与数据迁移。</p><span>Vue · ElementUI · 前端开发</span></div><Icon name="arrow-up-right-from-square" /></a>
      <a class="support-work" href={withBase('/projects/tunnel-ai')}><div class="support-icon green"><Icon name="microscope" /></div><div><p class="eyebrow">RESEARCH / 2025</p><h3>隧道病害图像识别</h3><p>识别代码开发、人工标注与技术资料整理。</p><span>Python · 图像识别 · 工程检测</span></div><Icon name="arrow-up-right-from-square" /></a>
    </div>
  </section>
  <section class="capability-band" aria-labelledby="cap-title"><div class="portfolio-wrap capability-layout">
    <div><p class="eyebrow">02 / SKILLS IN PRACTICE</p><h2 id="cap-title">技术与实践</h2><p class="section-description">按方向查看对应项目。</p>
      <div class="capability-switch" role="tablist" aria-label="能力方向">{lenses.map((lens,index)=><button id={`lens-tab-${lens.id}`} class:list={['lens-button',{active:index===0}]} role="tab" aria-selected={index===0?'true':'false'} aria-controls={`lens-${lens.id}`} tabindex={index===0?0:-1} data-lens={lens.id} disabled><Icon name={lens.icon} />{lens.label}<span aria-hidden="true">↗</span></button>)}</div>
      <noscript><p>下方已展开全部能力介绍，开启 JavaScript 后可切换查看。</p></noscript>
    </div>
    <div class="capability-panels">{lenses.map((lens,index)=><section class="lens-panel" id={`lens-${lens.id}`} role="tabpanel" aria-labelledby={`lens-tab-${lens.id}`} tabindex="0"><span class="lens-number" aria-hidden="true">0{index+1}</span><h3>{lens.headline}</h3><p>{lens.body}</p><div class="p-tags">{lens.tags.map(tag=><span>{tag}</span>)}</div><a href={withBase(lens.href)} class="lens-proof">{lens.proof}<Icon name="arrow-right" /></a></section>)}</div>
  </div></section>
  <section class="portfolio-wrap path-section" aria-labelledby="path-title">
    <div class="section-heading"><div><p class="eyebrow">03 / THE JOURNEY</p><h2 id="path-title">经历时间线</h2></div><a class="p-text-link" href={withBase('/resume')}>完整经历 <span aria-hidden="true">↗</span></a></div>
    <div class="mini-timeline">
      <a href={withBase('/resume#education')}><time>2018 — 2022</time><span class="timeline-dot"></span><h3>计算机科学本科</h3><p>齐鲁理工学院</p><span>国家励志奖学金 · 省赛三等奖</span></a>
      <a href={withBase('/projects/procurement')}><time>2022 — 2024</time><span class="timeline-dot"></span><h3>前端开发工程师</h3><p>禹王投资控股有限公司</p><span>采购平台 · 招标小程序</span></a>
      <a href={withBase('/projects/coding-class')}><time>2024</time><span class="timeline-dot"></span><h3>编程课程讲师</h3><p>莱凯创客机器人编程俱乐部</p><span>少儿编程 · 机器人课程</span></a>
      <a href={withBase('/resume#education')}><time>2025 — 至今</time><span class="timeline-dot"></span><h3>岩土工程硕士在读</h3><p>沈阳建筑大学</p><span>校级奖学金二等奖</span></a>
    </div>
  </section>
  <section class="portfolio-wrap notes-preview" aria-labelledby="notes-title"><div class="section-heading"><div><p class="eyebrow">04 / NOTES</p><h2 id="notes-title">项目笔记</h2></div><a class="p-text-link" href={withBase('/writing')}>所有笔记 <span aria-hidden="true">↗</span></a></div><div class="note-preview-grid">{notes.map((note,index)=><a class="note-preview" href={withBase(`/writing/${note.slug}`)}><span class="note-index">0{index+1} / {note.category}</span><h3>{note.title}</h3><p>{note.summary}</p><span class="note-read">{note.minutes} 分钟阅读 <Icon name="arrow-right" /></span></a>)}</div></section>
</BaseLayout>
<script>
  const lensTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-lens]')];
  function activateLens(button: HTMLButtonElement) {
    lensTabs.forEach(tab => {
      const selected = tab === button;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      tab.classList.toggle('active', selected);
      const panel = document.getElementById(`lens-${tab.dataset.lens}`);
      if (panel) panel.hidden = !selected;
    });
  }
  lensTabs.forEach((tab,index) => {
    tab.disabled = false;
    tab.addEventListener('click',()=>activateLens(tab));
    tab.addEventListener('keydown', event => {
      let next: number | undefined;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index+1)%lensTabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index-1+lensTabs.length)%lensTabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = lensTabs.length-1;
      if (next !== undefined) {event.preventDefault(); activateLens(lensTabs[next]); lensTabs[next].focus();}
    });
  });
  if (lensTabs[0]) activateLens(lensTabs[0]);
</script>
