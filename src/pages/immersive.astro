---
import BaseLayout from '../layouts/BaseLayout.astro';
import CosmicHeading from '../components/CosmicHeading.astro';
import { cosmicChapters } from '../data/cosmic-journey';
import { withBase } from '../paths';
import '../styles/immersive.css';
const assets = {
  earth: withBase('/images/cosmos/earth-day.webp'),
  night: withBase('/images/cosmos/earth-night.webp'),
  clouds: withBase('/images/cosmos/earth-clouds.webp'),
  moon: withBase('/images/cosmos/moon.webp'),
  saturn: withBase('/images/cosmos/saturn.webp'),
};
---
<BaseLayout title="宇宙漫游" description="滚动开启八站宇宙旅程：掠过月面与土星，穿越星云、恒星群和旋臂，回望银河全景。" showFooter={false}>
  <div class="cosmic-experience" data-cosmic data-assets={JSON.stringify(assets)} data-renderer="fallback" data-motion="system" data-chapter="earth" style={`--earth-map:url("${assets.earth}");--moon-map:url("${assets.moon}");--saturn-map:url("${assets.saturn}")`}>
    <div class="cosmic-stage" aria-hidden="true">
      <div class="cosmic-fallback-stars"></div>
      <div class="cosmic-fallback-world">
        <div class="cosmic-fallback-globe cosmic-fallback-earth"></div>
        <div class="cosmic-fallback-globe cosmic-fallback-moon"></div>
        <div class="cosmic-fallback-globe cosmic-fallback-saturn"></div>
        <div class="cosmic-fallback-galaxy"><div class="cosmic-fallback-core"></div><div class="cosmic-fallback-arms"></div></div>
      </div>
      <canvas class="cosmic-canvas" data-cosmic-canvas></canvas>
    </div>
    <div class="cosmic-rotation-surface" data-cosmic-rotation-surface role="group" tabindex="-1" aria-label="三维模型旋转" aria-describedby="cosmic-rotation-instructions" aria-keyshortcuts="ArrowLeft ArrowRight Home" hidden></div>
    <div class="cosmic-rotation-controls" data-cosmic-rotation-controls hidden><p id="cosmic-rotation-instructions">左右拖动旋转 · 上下滑动漫游<span class="cosmic-rotation-keyboard-hint">；键盘左右方向键旋转，Home 重置</span></p><button type="button" data-cosmic-reset-rotation>重置视角</button></div>
    <p class="cosmic-loading" data-cosmic-loading role="status">正在准备星空…</p>
    <nav class="cosmic-chapter-nav" aria-label="宇宙旅程章节">{cosmicChapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter-link data-active={index === 0 ? 'true' : 'false'} aria-current={index === 0 ? 'location' : undefined}><span class="cosmic-nav-dot" aria-hidden="true"></span><span class="cosmic-nav-label">{chapter.name}</span></a>)}</nav>
    <div class="cosmic-story" data-cosmic-story>
      {cosmicChapters.map((chapter, index) => <section class={`cosmic-step cosmic-step-${chapter.id}`} id={chapter.id} data-flight-step data-type-style={chapter.typeStyle} tabindex="-1" aria-labelledby={`${chapter.id}-title`}>
        <div class="cosmic-wrap"><div class="cosmic-copy">
          <p class="cosmic-kicker">{chapter.kicker}</p>
          <CosmicHeading id={`${chapter.id}-title`} lines={chapter.titleLines} first={index === 0} />
          <p class="cosmic-description">{chapter.description}</p>
          <div class="cosmic-actions">
            {index === 0 && <a class="cosmic-button" href={chapter.next.href}>{chapter.next.label}</a>}
            <button class={index === 0 ? 'cosmic-text-link' : 'cosmic-button'} type="button" data-cosmic-action={chapter.action.type} aria-pressed={chapter.action.type === 'warp' ? undefined : 'false'} disabled>{chapter.action.label}{chapter.action.icon && <span aria-hidden="true">{chapter.action.icon}</span>}</button>
            {index > 0 && <a class="cosmic-text-link" href={chapter.next.href}>{chapter.next.label}</a>}
          </div>
          {chapter.hint && <p class="cosmic-interaction-hint">{chapter.hint}</p>}
          {chapter.finish && <div class="cosmic-finish-links"><a href={withBase('/')}>返回个人网站 ↗</a></div>}
        </div></div>
      </section>)}
    </div>
    <div class="cosmic-hud">
      <div class="cosmic-hud-progress"><span class="cosmic-progress-label" data-cosmic-progress-label>地球启航 / 0%</span><div class="cosmic-progress" aria-hidden="true"><span data-cosmic-progress></span></div></div>
      <p class="cosmic-status" data-cosmic-status role="status" aria-live="polite">滚动探索 · 点击按钮互动</p>
      <div class="cosmic-hud-actions"><button type="button" data-cosmic-sound aria-label="开启环境音" aria-pressed="false" disabled><span aria-hidden="true">♫</span> 声音关</button><button type="button" data-cosmic-motion aria-pressed="false" disabled>静态模式</button><button type="button" data-cosmic-credits-open aria-haspopup="dialog" disabled>素材</button></div>
    </div>
    <dialog class="cosmic-credits" data-cosmic-credits aria-labelledby="credits-title"><div class="cosmic-credits-heading"><h2 id="credits-title">旅程与素材</h2><button type="button" data-cosmic-credits-close aria-label="关闭素材说明">×</button></div><p>星球贴图：<a href="https://ssi.solarsystemscope.com/textures/" target="_blank" rel="noreferrer">Solar System Scope / INOVE ↗</a>，基于 NASA 图像与地形资料。</p><p>使用 <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a> 许可；贴图已缩放并压缩为 WebP。</p><p>电影标题使用 <a href="https://github.com/notofonts/noto-cjk" target="_blank" rel="noreferrer">Noto Serif SC ↗</a>，按 SIL OFL 1.1 许可自托管，仅载入所需字形。</p><p>星云、恒星群与银河为程序化视觉演绎，距离和尺度并非天文测量值。</p><p class="cosmic-credits-reference">创意参考：<a href="https://tympanus.net/codrops/2026/07/22/building-ridgeline-engineering-a-real-time-3d-experience-in-webflow/" target="_blank" rel="noreferrer">Codrops ↗</a></p></dialog>
    <noscript><p class="cosmic-noscript">当前为静态阅读；启用 JavaScript 后可以体验镜头推进与互动。</p></noscript>
  </div>
</BaseLayout>
<script>import '../scripts/immersive';</script>
